AddDefaultCharset UTF-8
ErrorDocument 404 /404

RewriteEngine On

# www.chalupazdravavoda.cz -> chalupazdravavoda.cz (jedna hlavni adresa)
RewriteCond %{HTTP_HOST} ^www\.chalupazdravavoda\.cz$ [NC]
RewriteRule ^(.*)$ https://chalupazdravavoda.cz/$1 [L,R=301]

# index.html -> koren domeny
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ostatni *.html odkazy -> cista adresa bez pripony .html
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# interni preklad cisté adresy zpet na skutecny soubor .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
